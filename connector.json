      "name": "list_organization_projects",
      "description": "List organization projects.",
      "method": "POST",
      "path": "/graphql",
      "readOnly": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "organization": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "Value"
          },
          "first": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "after": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "Value"
          }
        },
        "required": [
          "organization",
          "first"
        ],
        "additionalProperties": false
      },
      "bindings": {
        "path": [],
        "query": {},
        "body": {
          "organization": "variables.organization",
          "first": "variables.first",
          "after": "variables.after"
        }
      },
      "sampleArguments": {
        "organization": "organization",
        "first": 10
      },
      "body": {
        "query": "query Projects($organization: String!, $first: Int!, $after: String) { organization(login: $organization) { projectsV2(first: $first, after: $after) { nodes { id title number url closed } pageInfo { hasNextPage endCursor } } } }"
      },
      "pagination": {
        "type": "cursor",
        "cursorInput": "after",
        "nextCursorPath": "data.organization.projectsV2.pageInfo.endCursor",
        "hasMorePath": "data.organization.projectsV2.pageInfo.hasNextPage"
      },
      "provenance": [
        "https://docs.github.com/en/graphql/overview/public-schema",
        "https://docs.github.com/en/issues/planning-and-tracking-with-projects/automating-your-project/using-the-api-to-manage-projects"
      ],
      "approvalRequired": false,
      "evidence": {
        "providerLiveValidation": "not-run",
        "localValidation": "provider-request-fixture"
      }
    },
