      "bindings": {
        "path": [],
        "query": {},
        "body": {
          "projectId": "variables.projectId",
          "first": "variables.first",
          "after": "variables.after"
        }
      },
      "sampleArguments": {
        "projectId": "PVT_example",
        "first": 10
      },
      "body": {
        "query": "query Items($projectId: ID!, $first: Int!, $after: String) { node(id: $projectId) { ... on ProjectV2 { title items(first: $first, after: $after) { nodes { id type content { ... on Issue { title url } ... on PullRequest { title url } ... on DraftIssue { title } } } pageInfo { hasNextPage endCursor } } } } }"
      },
      "pagination": {
        "type": "cursor",
        "cursorInput": "after",
        "nextCursorPath": "data.node.items.pageInfo.endCursor",
        "hasMorePath": "data.node.items.pageInfo.hasNextPage"
      },
