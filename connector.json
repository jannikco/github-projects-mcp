      "name": "list_project_items",
      "description": "List project items.",
      "method": "POST",
      "path": "/graphql",
      "readOnly": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
